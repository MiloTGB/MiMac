#!/usr/bin/env bash
# status — the dashboard's panels as plain text: what make status prints.
#
# This is mimac-status --plain, run from this checkout. It used to be a second
# implementation of the installation checks in bash, beside the dashboard's in
# Go, and the two had drifted: each read different paths for the same facts.
# There is now one set of checks, in tools/mimac-status (as mrk did on
# 2026-09-30).
#
# Not linked into ~/bin: ~/bin/status is the dashboard itself, which make
# mimac-status links there, and setup skips this file for that reason
# (mimac_skip_link).
set -euo pipefail

_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
REPO_ROOT="$(cd "$(dirname "$_self")/.." && pwd)"

case "${1:-}" in
  -h|--help)
    cat <<'USAGE'
status — print mimac-status's panels as plain text

Usage:
  status [--help | -h]

Runs this checkout's bin/mimac-status --plain, reporting on this checkout
unless MIMAC_ROOT names another: Unrecorded, Upkeep, Time Machine Backups and
Installation, each line with its fix. The dashboard itself is `status` on the
PATH, or `mimac-status`.
USAGE
    exit 0 ;;
  ?*) printf 'status: unknown argument: %s\n' "$1" >&2; exit 2 ;;
esac

bin="$REPO_ROOT/bin/mimac-status"
if [[ ! -x "$bin" ]]; then
  printf 'status: %s is not built. Build it with: make -C %s build-tools\n' "$bin" "$REPO_ROOT" >&2
  exit 1
fi
MIMAC_ROOT="${MIMAC_ROOT:-$REPO_ROOT}" exec "$bin" --plain
