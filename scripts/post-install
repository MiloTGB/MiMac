#!/usr/bin/env bash
set -euo pipefail

# MiMac post-install — configure apps installed by Homebrew
#
# Run after `make install` to set up login items and link configs
# that depend on Homebrew-installed packages.

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly SCRIPT_DIR REPO_ROOT

# Source shared helpers
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

failed=0
incr_failed(){ failed=$((failed + 1)); }

PLIST_BACKUP_DIR="$STATE_DIR/plist-backups"
ROLLBACK="${ROLLBACK:-$STATE_DIR/defaults-rollback.sh}"
# Initialize rollback script if it doesn't exist
[[ -f "$ROLLBACK" ]] || touch "$ROLLBACK"


# Run a defaults script, log the result
apply_defaults(){
  local script="$1" name="$2"
  if bash "$script"; then
    log "Applied $name defaults"
  else
    log "Warning: $name defaults script failed"
    return 1
  fi
}

# Copy a managed policy JSON to the browser's policy directory
install_browser_policy(){
  local src="$1" dest_dir="$2" name="$3"
  local dest="$dest_dir/mimac-policy.json"
  if ! mkdir -p "$dest_dir"; then
    warn "Failed to create policy directory: $dest_dir"
    return 1
  fi
  if [[ -f "$dest" ]] && cmp -s "$src" "$dest"; then
    log "$name policy already installed"
    return 0
  fi
  cp "$src" "$dest"
  log "Installed $name managed policy → $dest"
}

# Open extension URLs from a list file, one per line
open_extension_urls(){
  local list_file="$1" name="$2"
  local count=0 url
  while IFS= read -r url || [[ -n "$url" ]]; do
    url="${url%%#*}"          # strip inline comments
    url="${url#"${url%%[![:space:]]*}"}"  # trim leading whitespace
    url="${url%"${url##*[![:space:]]}"}"  # trim trailing whitespace
    [[ -z "$url" ]] && continue
    open "$url"
    ((count++))
  done < "$list_file"
  log "Opened $count $name extension URL(s)"
}

###############################################################################
# Topgrade configuration                                                      #
###############################################################################

TOPGRADE_SRC="$REPO_ROOT/assets/topgrade.toml"
TOPGRADE_DST="$HOME/.config/topgrade.toml"

if command -v topgrade >/dev/null 2>&1 && [[ -f "$TOPGRADE_SRC" ]]; then
  mkdir -p "$HOME/.config" || { warn "Failed to create $HOME/.config"; }
  if [[ -L "$TOPGRADE_DST" ]] && [[ "$(readlink "$TOPGRADE_DST")" == "$TOPGRADE_SRC" ]]; then
    log "Topgrade config already linked"
  else
    [[ -f "$TOPGRADE_DST" ]] && mv "$TOPGRADE_DST" "${TOPGRADE_DST}.bak"
    ln -s "$TOPGRADE_SRC" "$TOPGRADE_DST"
    log "Linked topgrade config → $TOPGRADE_DST"
  fi
else
  log "Skipping topgrade config (topgrade not installed)"
fi

###############################################################################
# GitHub CLI configuration                                                    #
###############################################################################

GH_SRC="$REPO_ROOT/assets/gh/config.yml"
GH_DST="$HOME/.config/gh/config.yml"

if command -v gh >/dev/null 2>&1 && [[ -f "$GH_SRC" ]]; then
  mkdir -p "$HOME/.config/gh" || { warn "Failed to create $HOME/.config/gh"; }
  if [[ -L "$GH_DST" ]] && [[ "$(readlink "$GH_DST")" == "$GH_SRC" ]]; then
    log "GitHub CLI config already linked"
  else
    [[ -f "$GH_DST" ]] && mv "$GH_DST" "${GH_DST}.bak"
    ln -s "$GH_SRC" "$GH_DST"
    log "Linked GitHub CLI config → $GH_DST"
  fi
else
  log "Skipping GitHub CLI config (gh not installed)"
fi

###############################################################################
# htop configuration                                                          #
###############################################################################

HTOP_SRC="$REPO_ROOT/assets/htop/htoprc"
HTOP_DST="$HOME/.config/htop/htoprc"

if command -v htop >/dev/null 2>&1 && [[ -f "$HTOP_SRC" ]]; then
  mkdir -p "$HOME/.config/htop" || { warn "Failed to create $HOME/.config/htop"; }
  if [[ -L "$HTOP_DST" ]] && [[ "$(readlink "$HTOP_DST")" == "$HTOP_SRC" ]]; then
    log "htop config already linked"
  else
    [[ -f "$HTOP_DST" ]] && mv "$HTOP_DST" "${HTOP_DST}.bak"
    ln -s "$HTOP_SRC" "$HTOP_DST"
    log "Linked htop config → $HTOP_DST"
  fi
else
  log "Skipping htop config (htop not installed)"
fi

###############################################################################
# Custom fonts                                                                #
###############################################################################

FONTS_SRC="$REPO_ROOT/assets/fonts"
FONTS_DST="$HOME/Library/Fonts"

if [[ -d "$FONTS_SRC" ]]; then
  installed=0 skipped=0
  for font in "$FONTS_SRC"/*; do
    [[ -f "$font" ]] || continue
    fname="$(basename "$font")"
    if [[ -f "$FONTS_DST/$fname" ]]; then
      skipped=$((skipped + 1))
    else
      cp "$font" "$FONTS_DST/$fname"
      installed=$((installed + 1))
    fi
  done
  log "Fonts: $installed installed, $skipped already present"
fi

###############################################################################
# Browser preferences                                                        #
###############################################################################

BROWSERS_DIR="$REPO_ROOT/assets/browsers"

# Google Chrome
if [[ -d "/Applications/Google Chrome.app" ]]; then
  install_browser_policy "$BROWSERS_DIR/chrome-policy.json" \
    "$HOME/Library/Application Support/Google/Chrome/policies/managed" \
    "Chrome" || incr_failed
  if [[ -f "$BROWSERS_DIR/chrome-extensions.txt" ]]; then
    if [[ -t 0 ]]; then
      printf "[post-install] Open Chrome extension URLs? [y/N]: "
      read -r answer </dev/tty
      if [[ "$answer" =~ ^[Yy]$ ]]; then
        open_extension_urls "$BROWSERS_DIR/chrome-extensions.txt" "Chrome" || incr_failed
      else
        log "Skipped Chrome extension URLs"
      fi
    fi
  fi
else
  log "Skipping Chrome (not installed)"
fi

# Brave
if [[ -d "/Applications/Brave Browser.app" ]]; then
  install_browser_policy "$BROWSERS_DIR/brave-policy.json" \
    "$HOME/Library/Application Support/BraveSoftware/Brave-Browser/policies/managed" \
    "Brave" || incr_failed
  if [[ -f "$BROWSERS_DIR/brave-extensions.txt" ]]; then
    if [[ -t 0 ]]; then
      printf "[post-install] Open Brave extension URLs? [y/N]: "
      read -r answer </dev/tty
      if [[ "$answer" =~ ^[Yy]$ ]]; then
        open_extension_urls "$BROWSERS_DIR/brave-extensions.txt" "Brave" || incr_failed
      else
        log "Skipped Brave extension URLs"
      fi
    fi
  fi
else
  log "Skipping Brave (not installed)"
fi

###############################################################################
# Companion apps (installed from GitHub releases)                             #
###############################################################################

install_github_app(){
  local app_path="$1" repo="$2" name="$3"
  # Install-only: skips if the app is already present.
  if [[ -d "$app_path" ]]; then
    log "$name already installed — skipping"
    return 0
  fi
  local dmg_url
  dmg_url=$(curl -sf "https://api.github.com/repos/${repo}/releases/latest" \
    | grep -oE '"browser_download_url": "[^"]+"' | grep "\.dmg" | head -1 | cut -d '"' -f 4)
  if [[ -z "$dmg_url" ]]; then
    log "Warning: could not find $name DMG in latest release"
    return 1
  fi
  name="${name//[^[:alnum:]._-]/}"
  local tmp_dmg tmp_mount
  tmp_dmg=$(mktemp)
  tmp_mount=$(mktemp -d)
  _cleanup_github_app() {
    hdiutil detach "$tmp_mount" -quiet 2>/dev/null || true
    rm -f "$tmp_dmg"
    rm -rf "$tmp_mount" 2>/dev/null || true
  }
  trap _cleanup_github_app EXIT
  log "Downloading $name..."
  curl -L -sf -o "$tmp_dmg" "$dmg_url" || { log "Warning: failed to download $name"; rm -f "$tmp_dmg"; return 1; }
  hdiutil attach "$tmp_dmg" -mountpoint "$tmp_mount" -quiet -nobrowse \
    || { log "Warning: failed to mount $name DMG"; rm -f "$tmp_dmg"; rm -rf "$tmp_mount" 2>/dev/null; return 1; }
  local found_app
  found_app=$(find "$tmp_mount" -maxdepth 2 -name "*.app" -type d | head -1)
  if [[ -z "$found_app" ]]; then
    log "Warning: no .app found in $name DMG"
    hdiutil detach "$tmp_mount" -quiet; rm -f "$tmp_dmg"; return 1
  fi
  cp -R "$found_app" /Applications/ \
    || { log "Warning: failed to copy $name to /Applications"; hdiutil detach "$tmp_mount" -quiet; rm -f "$tmp_dmg"; return 1; }
  hdiutil detach "$tmp_mount" -quiet
  rm -f "$tmp_dmg"
  rm -rf "$tmp_mount" 2>/dev/null || true
  trap - EXIT
  if [[ -d "$app_path" ]]; then
    xattr -cr "$app_path" 2>/dev/null || true
  fi
  log "Installed $name → $app_path"
}

install_github_app "/Applications/Barkeep.app" "sevmorris/Barkeep" "Barkeep" || incr_failed


###############################################################################
# Application preferences — defaults write scripts                            #
###############################################################################

PREFS_DIR="$REPO_ROOT/assets/preferences"

# Audio Hijack
if [[ -d "/Applications/Audio Hijack.app" ]]; then
  apply_defaults "$PREFS_DIR/audio-hijack-defaults.sh" "Audio Hijack" || incr_failed
else
  log "Skipping Audio Hijack defaults (not installed)"
fi

# Rogue Amoeba — disable Sparkle auto-updates (managed by topgrade)
if [[ -d "/Applications/Audio Hijack.app" ]] || [[ -d "/Applications/Loopback.app" ]] || [[ -d "/Applications/SoundSource.app" ]]; then
  apply_defaults "$PREFS_DIR/rogue-amoeba-updates.sh" "Rogue Amoeba updates" || incr_failed
else
  log "Skipping Rogue Amoeba update defaults (no RA apps installed)"
fi

###############################################################################
# Preferences directory setup                                                 #
###############################################################################

LOCAL_PREFS_DIR="$HOME/.mimac/preferences"
mkdir -p "$LOCAL_PREFS_DIR"

# Switch MiMac repo remote from HTTPS to SSH if possible
if ssh -T git@github.com 2>&1 | grep -q "successfully authenticated"; then
  _current_url=$(git -C "$REPO_ROOT" remote get-url origin 2>/dev/null || true)
  if [[ "$_current_url" == https://* ]]; then
    _ssh_url="${_current_url/https:\/\/github.com\//git@github.com:}"
    git -C "$REPO_ROOT" remote set-url origin "$_ssh_url"
    log "Switched MiMac remote to SSH: $_ssh_url"
  fi
fi

###############################################################################
# Application preferences — plist imports                                     #
###############################################################################

# Snapshot the current state of a defaults domain into PLIST_BACKUP_DIR
backup_plist(){
  local domain="$1"
  mkdir -p "$PLIST_BACKUP_DIR"
  defaults export "$domain" "$PLIST_BACKUP_DIR/${domain}.plist" 2>/dev/null || true
}

# Import a full plist if the app is installed and not already configured
import_plist(){
  local app_path="$1" bundle_id="$2" plist_file="$3" name="$4"
  if [[ ! -d "$app_path" ]]; then
    logskip "$name plist" "not installed"
    return 0
  fi
  if [[ ! -f "$plist_file" ]]; then
    logskip "$name plist" "asset missing"
    return 0
  fi
  # Only import if the app hasn't been configured yet (no existing plist)
  local existing="$HOME/Library/Preferences/${bundle_id}.plist"
  if [[ -f "$existing" ]]; then
    logskip "$name plist" "exists — skipping import (won't overwrite)"
    return 0
  fi

  backup_plist "$bundle_id"
  defaults import "$bundle_id" "$plist_file" || return 1

  {
    if [[ -f "$PLIST_BACKUP_DIR/${bundle_id}.plist" ]]; then
      printf 'defaults import %s %s\n' \
        "$(printf '%q' "$bundle_id")" \
        "$(printf '%q' "$PLIST_BACKUP_DIR/${bundle_id}.plist")"
    else
      printf 'defaults delete %s >/dev/null 2>&1 || true\n' \
        "$(printf '%q' "$bundle_id")"
    fi
  } >> "$ROLLBACK"

  log "Imported $name preferences"
}

import_plist "/Applications/iTerm.app" "com.googlecode.iterm2" \
  "$LOCAL_PREFS_DIR/iTerm2.plist" "iTerm2" || incr_failed

import_plist "/Applications/Audio Hijack.app" "com.rogueamoeba.audiohijack" \
  "$LOCAL_PREFS_DIR/AudioHijack.plist" "Audio Hijack" || incr_failed

import_plist "/Applications/Loopback.app" "com.rogueamoeba.Loopback" \
  "$LOCAL_PREFS_DIR/Loopback.plist" "Loopback" || incr_failed

import_plist "/Applications/SoundSource.app" "com.rogueamoeba.soundsource" \
  "$LOCAL_PREFS_DIR/SoundSource.plist" "SoundSource" || incr_failed



###############################################################################
# Application Support restore                                                #
###############################################################################

restore_app_support(){
  local app_name="$1" src_subdir="$2"
  shift 2
  local files=("$@")
  local src_dir="$LOCAL_PREFS_DIR/app-support/$src_subdir"
  local dest_dir="$HOME/Library/Application Support/$app_name"

  if [[ ! -d "$src_dir" ]]; then
    log "Skipping $app_name app support restore (no backup found)"
    return 0
  fi

  if ! mkdir -p "$dest_dir"; then
    warn "Failed to create app support directory: $dest_dir"
    return 1
  fi
  local restored=0
  for file in "${files[@]}"; do
    if [[ -f "$src_dir/$file" ]] && [[ ! -f "$dest_dir/$file" ]]; then
      cp "$src_dir/$file" "$dest_dir/$file"
      restored=$(( restored + 1 ))
    fi
  done
  if (( restored > 0 )); then
    log "Restored $app_name app support ($restored file(s))"
  else
    log "$app_name app support already present — skipping restore"
  fi
}

restore_app_support "Loopback" "Loopback" \
  "Devices.plist" "RecentApps.plist"

restore_app_support "SoundSource" "SoundSource" \
  "Presets.plist" "CustomPresets.plist" "Sources.plist" "Models.plist"

###############################################################################
# Login items                                                                 #
###############################################################################

# Add a login item if the app exists and isn't already registered
add_login_item(){
  local app_path="$1"
  local app_name
  app_name=$(basename "$app_path" .app)

  if [[ ! -d "$app_path" ]]; then
    log "Skipping login item (not installed): $app_name"
    return 0
  fi

  # Check/add login items via System Events (requires Automation permission)
  local osascript_err
  if osascript_err=$(osascript <<'SCPT' 2>&1
tell application "System Events" to get the name of every login item
SCPT
  ); then
    if echo "$osascript_err" | grep -qF "$app_name"; then
      log "Login item already exists: $app_name"
      return 0
    fi
  else
    if echo "$osascript_err" | grep -qF "Not authorized"; then
      log "Cannot manage login items (Automation permission not granted)"
      log "  → Add $app_name manually: System Settings → General → Login Items"
      return 0
    fi
    return 1
  fi

  if ! osascript - "$app_path" <<'EOF' >/dev/null 2>&1
on run argv
  set appPath to item 1 of argv
  tell application "System Events" to make login item at end with properties {path:appPath, hidden:false}
end run
EOF
  then
    log "Failed to add login item: $app_name"
    log "  → Add manually: System Settings → General → Login Items"
    return 1
  fi
  log "Added login item: $app_name"
}

# Add login items for apps on this machine
add_login_item "/Applications/noTunes.app"          || failed=$(( failed + 1 ))
add_login_item "/Applications/SoundSource.app"      || failed=$(( failed + 1 ))
add_login_item "/Applications/Loopback.app"         || failed=$(( failed + 1 ))

###############################################################################
# LaunchAgents                                                                #
###############################################################################

install_launch_agent(){
  local plist_name="$1"
  local src_plist="$REPO_ROOT/assets/launchagents/$plist_name"
  local dest_dir="$HOME/Library/LaunchAgents"
  local dest_plist="$dest_dir/$plist_name"

  if [[ ! -f "$src_plist" ]]; then
    return 0
  fi

  mkdir -p "$dest_dir"

  if [[ -f "$dest_plist" ]] && cmp -s "$src_plist" "$dest_plist"; then
    logskip "LaunchAgent $plist_name" "already installed"
    return 0
  fi

  cp "$src_plist" "$dest_plist"

  # Unload before loading. launchd keys a job by its Label, not by the file, so
  # `launchctl load` on a label that is already loaded fails with "Load failed:
  # 5: Input/output error" and leaves the OLD definition running. Because the
  # cmp above returns early when the file is unchanged, the only time this line
  # is reached is when the plist changed — exactly the case the bare load could
  # not apply. An edited schedule silently kept the previous one until the next
  # logout. The unload is expected to fail on a first install, hence || true.
  launchctl unload "$dest_plist" >/dev/null 2>&1 || true
  launchctl load "$dest_plist" >/dev/null 2>&1 || true

  ok "Installed LaunchAgent → $plist_name"
}

# Clears the Discord and Chrome caches daily at 03:00. The agent invokes
# ~/bin/clear-app-caches, which `make setup` symlinks into place — install the
# agent after that link exists, or the first run finds nothing to execute.
install_launch_agent "com.user.clear_app_caches.plist" || failed=$(( failed + 1 ))

###############################################################################
# Summary                                                                     #
###############################################################################

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if (( failed > 0 )); then
  printf '%s%s  ⚠ Installation Complete (with warnings)%s\n' "$_B" "$_YLW" "$_R"
else
  printf '%s%s  ✓ Installation Complete%s\n' "$_B" "$_GRN" "$_R"
fi
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

if (( failed > 0 )); then
  warn "Some post-install steps failed. Check the log for details:"
  printf '%s    %s%s\n' "$_CYN" "$LOGFILE" "$_R"
  echo ""
fi

log "MiMac setup is complete! Here's what to do next:"
echo ""
printf '%s  1.%s Reload your shell:\n' "$_B" "$_R"
printf '%s     %s%s\n' "$_CYN" "exec zsh" "$_R"
echo ""
printf '%s  2.%s Verify installation:\n' "$_B" "$_R"
printf '%s     %s%s\n' "$_CYN" "make status" "$_R"
echo ""
printf '%s  3.%s Manual steps remaining:\n' "$_B" "$_R"
echo "     • Mac App Store apps (Final Cut Pro, iMovie, etc.)"
echo "     • Safari settings (sandboxed on macOS Sequoia+)"
echo "     • Sign in to 1Password, cloud storage, etc."
echo ""
printf '%s  4.%s Useful commands:\n' "$_B" "$_R"
printf '%s     %s%-20s%s — %s\n' "$_CYN" "$_R" "make sync" "$_CYN" "Sync Brewfile with installed packages$_R"
printf '%s     %s%-20s%s — %s\n' "$_CYN" "$_R" "make snapshot-prefs" "$_CYN" "Export app preferences$_R"
printf '%s     %s%-20s%s — %s\n' "$_CYN" "$_R" "make update" "$_CYN" "Update all packages (via topgrade)$_R"
printf '%s     %s%-20s%s — %s\n' "$_CYN" "$_R" "make help" "$_CYN" "Show all available commands$_R"
echo ""
printf '%s  📖 Documentation:%s https://milotgb.github.io/MiMac/\n' "$_B" "$_R"
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
