#!/usr/bin/env bash
set -euo pipefail

# MiMac post-install — configure apps installed by Homebrew
#
# Run after `make install` to set up login items and link configs
# that depend on Homebrew-installed packages.

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly SCRIPT_DIR REPO_ROOT

log(){ printf "[post-install] %s\n" "$*"; }

failed=0
incr_failed(){ failed=$((failed + 1)); }

# Run a defaults script, log the result
apply_defaults(){
  local script="$1" name="$2"
  if bash "$script"; then
    log "Applied $name defaults"
  else
    log "Warning: $name defaults script failed"
    return 1
  fi
}

# Copy a managed policy JSON to the browser's policy directory
install_browser_policy(){
  local src="$1" dest_dir="$2" name="$3"
  local dest="$dest_dir/mimac-policy.json"
  mkdir -p "$dest_dir"
  if [[ -f "$dest" ]] && cmp -s "$src" "$dest"; then
    log "$name policy already installed"
    return 0
  fi
  cp "$src" "$dest"
  log "Installed $name managed policy → $dest"
}

# Open extension URLs from a list file, one per line
open_extension_urls(){
  local list_file="$1" name="$2"
  local count=0 url
  while IFS= read -r url || [[ -n "$url" ]]; do
    url="${url%%#*}"          # strip inline comments
    url="${url#"${url%%[![:space:]]*}"}"  # trim leading whitespace
    url="${url%"${url##*[![:space:]]}"}"  # trim trailing whitespace
    [[ -z "$url" ]] && continue
    open "$url"
    ((count++))
  done < "$list_file"
  log "Opened $count $name extension URL(s)"
}

###############################################################################
# Topgrade configuration                                                      #
###############################################################################

TOPGRADE_SRC="$REPO_ROOT/assets/topgrade.toml"
TOPGRADE_DST="$HOME/.config/topgrade.toml"

if command -v topgrade >/dev/null 2>&1 && [[ -f "$TOPGRADE_SRC" ]]; then
  mkdir -p "$HOME/.config"
  if [[ -L "$TOPGRADE_DST" ]] && [[ "$(readlink "$TOPGRADE_DST")" == "$TOPGRADE_SRC" ]]; then
    log "Topgrade config already linked"
  else
    [[ -f "$TOPGRADE_DST" ]] && mv "$TOPGRADE_DST" "${TOPGRADE_DST}.bak"
    ln -s "$TOPGRADE_SRC" "$TOPGRADE_DST"
    log "Linked topgrade config → $TOPGRADE_DST"
  fi
else
  log "Skipping topgrade config (topgrade not installed)"
fi

###############################################################################
# GitHub CLI configuration                                                    #
###############################################################################

GH_SRC="$REPO_ROOT/assets/gh/config.yml"
GH_DST="$HOME/.config/gh/config.yml"

if command -v gh >/dev/null 2>&1 && [[ -f "$GH_SRC" ]]; then
  mkdir -p "$HOME/.config/gh"
  if [[ -L "$GH_DST" ]] && [[ "$(readlink "$GH_DST")" == "$GH_SRC" ]]; then
    log "GitHub CLI config already linked"
  else
    [[ -f "$GH_DST" ]] && mv "$GH_DST" "${GH_DST}.bak"
    ln -s "$GH_SRC" "$GH_DST"
    log "Linked GitHub CLI config → $GH_DST"
  fi
else
  log "Skipping GitHub CLI config (gh not installed)"
fi

###############################################################################
# htop configuration                                                          #
###############################################################################

HTOP_SRC="$REPO_ROOT/assets/htop/htoprc"
HTOP_DST="$HOME/.config/htop/htoprc"

if command -v htop >/dev/null 2>&1 && [[ -f "$HTOP_SRC" ]]; then
  mkdir -p "$HOME/.config/htop"
  if [[ -L "$HTOP_DST" ]] && [[ "$(readlink "$HTOP_DST")" == "$HTOP_SRC" ]]; then
    log "htop config already linked"
  else
    [[ -f "$HTOP_DST" ]] && mv "$HTOP_DST" "${HTOP_DST}.bak"
    ln -s "$HTOP_SRC" "$HTOP_DST"
    log "Linked htop config → $HTOP_DST"
  fi
else
  log "Skipping htop config (htop not installed)"
fi

###############################################################################
# Custom fonts                                                                #
###############################################################################

FONTS_SRC="$REPO_ROOT/assets/fonts"
FONTS_DST="$HOME/Library/Fonts"

if [[ -d "$FONTS_SRC" ]]; then
  installed=0 skipped=0
  for font in "$FONTS_SRC"/*; do
    [[ -f "$font" ]] || continue
    fname="$(basename "$font")"
    if [[ -f "$FONTS_DST/$fname" ]]; then
      skipped=$((skipped + 1))
    else
      cp "$font" "$FONTS_DST/$fname"
      installed=$((installed + 1))
    fi
  done
  log "Fonts: $installed installed, $skipped already present"
fi

###############################################################################
# Browser preferences                                                        #
###############################################################################

BROWSERS_DIR="$REPO_ROOT/assets/browsers"


# Google Chrome
if [[ -d "/Applications/Google Chrome.app" ]]; then
  install_browser_policy "$BROWSERS_DIR/chrome-policy.json" \
    "$HOME/Library/Application Support/Google/Chrome/policies/managed" \
    "Chrome" || incr_failed
  if [[ -f "$BROWSERS_DIR/chrome-extensions.txt" ]]; then
    if [[ -t 0 ]]; then
      printf "[post-install] Open Chrome extension URLs? [y/N]: "
      read -r answer </dev/tty
      if [[ "$answer" =~ ^[Yy]$ ]]; then
        open_extension_urls "$BROWSERS_DIR/chrome-extensions.txt" "Chrome" || incr_failed
      else
        log "Skipped Chrome extension URLs"
      fi
    fi
  fi
else
  log "Skipping Chrome (not installed)"
fi

# Brave
if [[ -d "/Applications/Brave Browser.app" ]]; then
  install_browser_policy "$BROWSERS_DIR/brave-policy.json" \
    "$HOME/Library/Application Support/BraveSoftware/Brave-Browser/policies/managed" \
    "Brave" || incr_failed
  if [[ -f "$BROWSERS_DIR/brave-extensions.txt" ]]; then
    if [[ -t 0 ]]; then
      printf "[post-install] Open Brave extension URLs? [y/N]: "
      read -r answer </dev/tty
      if [[ "$answer" =~ ^[Yy]$ ]]; then
        open_extension_urls "$BROWSERS_DIR/brave-extensions.txt" "Brave" || incr_failed
      else
        log "Skipped Brave extension URLs"
      fi
    fi
  fi
else
  log "Skipping Brave (not installed)"
fi

###############################################################################
# Application preferences — defaults write scripts                            #
###############################################################################

PREFS_DIR="$REPO_ROOT/assets/preferences"

# Audio Hijack
if [[ -d "/Applications/Audio Hijack.app" ]]; then
  apply_defaults "$PREFS_DIR/audio-hijack-defaults.sh" "Audio Hijack" || incr_failed
else
  log "Skipping Audio Hijack defaults (not installed)"
fi

# Rogue Amoeba — disable Sparkle auto-updates (managed by topgrade)
if [[ -d "/Applications/Audio Hijack.app" ]] || [[ -d "/Applications/Loopback.app" ]] || [[ -d "/Applications/SoundSource.app" ]]; then
  apply_defaults "$PREFS_DIR/rogue-amoeba-updates.sh" "Rogue Amoeba updates" || incr_failed
else
  log "Skipping Rogue Amoeba update defaults (no RA apps installed)"
fi

###############################################################################
# Preferences auto-pull                                                       #
###############################################################################

PREFS_REPO="git@github.com:MiloTGB/mimac-prefs.git"
LOCAL_PREFS_DIR="$HOME/.mimac/preferences"

if [[ ! -d "$LOCAL_PREFS_DIR/.git" ]]; then
  # Check if SSH is authenticated to GitHub
  if ssh -T git@github.com 2>&1 | grep -q "successfully authenticated"; then
    log "Cloning mimac-prefs..."
    mkdir -p "$(dirname "$LOCAL_PREFS_DIR")"
    git clone "$PREFS_REPO" "$LOCAL_PREFS_DIR" 2>/dev/null || {
      log "Warning: failed to clone mimac-prefs (SSH key may not have access)"
    }
  else
    log "Skipping mimac-prefs auto-pull (SSH not authenticated with GitHub)"
    log "  → Run: make pull-prefs (after adding SSH key to GitHub)"
  fi
else
  log "Preferences repo already present at $LOCAL_PREFS_DIR"
fi

###############################################################################
# Application preferences — plist imports                                     #
###############################################################################

# Import a full plist if the app is installed and not already configured
import_plist(){
  local app_path="$1" bundle_id="$2" plist_file="$3" name="$4"
  if [[ ! -d "$app_path" ]]; then
    log "Skipping $name plist (not installed)"
    return 0
  fi
  if [[ ! -f "$plist_file" ]]; then
    log "Skipping $name plist (asset missing)"
    return 0
  fi
  # Only import if the app hasn't been configured yet (no existing plist)
  local existing="$HOME/Library/Preferences/${bundle_id}.plist"
  if [[ -f "$existing" ]]; then
    log "$name plist already exists — skipping import (won't overwrite)"
    return 0
  fi
  defaults import "$bundle_id" "$plist_file"
  log "Imported $name preferences"
}

import_plist "/Applications/iTerm.app" "com.googlecode.iterm2" \
  "$LOCAL_PREFS_DIR/iTerm2.plist" "iTerm2" || incr_failed

import_plist "/Applications/Audio Hijack.app" "com.rogueamoeba.audiohijack" \
  "$LOCAL_PREFS_DIR/AudioHijack.plist" "Audio Hijack" || incr_failed

import_plist "/Applications/Loopback.app" "com.rogueamoeba.Loopback" \
  "$LOCAL_PREFS_DIR/Loopback.plist" "Loopback" || incr_failed

import_plist "/Applications/SoundSource.app" "com.rogueamoeba.soundsource" \
  "$LOCAL_PREFS_DIR/SoundSource.plist" "SoundSource" || incr_failed

import_plist "/Applications/BetterSnapTool.app" "com.hegenberg.BetterSnapTool" \
  "$LOCAL_PREFS_DIR/BetterSnapTool.plist" "BetterSnapTool" || incr_failed

import_plist "/Applications/Ice.app" "com.jordanbaird.Ice" \
  "$LOCAL_PREFS_DIR/Ice.plist" "Ice" || incr_failed

import_plist "/Applications/Raycast.app" "com.raycast.macos" \
  "$LOCAL_PREFS_DIR/Raycast.plist" "Raycast" || incr_failed

import_plist "/Applications/Stats.app" "eu.exelban.Stats" \
  "$LOCAL_PREFS_DIR/Stats.plist" "Stats" || incr_failed

import_plist "/Applications/Farrago.app" "com.rogueamoeba.farrago" \
  "$LOCAL_PREFS_DIR/Farrago.plist" "Farrago" || incr_failed

import_plist "/Applications/Piezo.app" "com.rogueamoeba.Piezo" \
  "$LOCAL_PREFS_DIR/Piezo.plist" "Piezo" || incr_failed

import_plist "/Applications/Typora.app" "abnerworks.Typora" \
  "$LOCAL_PREFS_DIR/Typora.plist" "Typora" || incr_failed

import_plist "/Applications/Hot.app" "com.xs-labs.Hot" \
  "$LOCAL_PREFS_DIR/Hot.plist" "Hot" || incr_failed

import_plist "/Applications/Keka.app" "com.aone.keka" \
  "$LOCAL_PREFS_DIR/Keka.plist" "Keka" || incr_failed

import_plist "/Applications/TimeMachineEditor.app" "com.tclementdev.timemachineeditor.application" \
  "$LOCAL_PREFS_DIR/TimeMachineEditor.plist" "TimeMachineEditor" || incr_failed

import_plist "/Applications/MacWhisper.app" "com.goodsnooze.MacWhisper" \
  "$LOCAL_PREFS_DIR/MacWhisper.plist" "MacWhisper" || incr_failed

###############################################################################
# Application Support restore                                                #
###############################################################################

restore_app_support(){
  local app_name="$1" src_subdir="$2"
  shift 2
  local files=("$@")
  local src_dir="$LOCAL_PREFS_DIR/app-support/$src_subdir"
  local dest_dir="$HOME/Library/Application Support/$app_name"

  if [[ ! -d "$src_dir" ]]; then
    log "Skipping $app_name app support restore (no backup found)"
    return 0
  fi

  mkdir -p "$dest_dir"
  local restored=0
  for file in "${files[@]}"; do
    if [[ -f "$src_dir/$file" ]] && [[ ! -f "$dest_dir/$file" ]]; then
      cp "$src_dir/$file" "$dest_dir/$file"
      restored=$(( restored + 1 ))
    fi
  done
  if (( restored > 0 )); then
    log "Restored $app_name app support ($restored file(s))"
  else
    log "$app_name app support already present — skipping restore"
  fi
}

restore_app_support "Loopback" "Loopback" \
  "Devices.plist" "RecentApps.plist"

restore_app_support "SoundSource" "SoundSource" \
  "Presets.plist" "CustomPresets.plist" "Sources.plist" "Models.plist"

###############################################################################
# Login items                                                                 #
###############################################################################

# Add a login item if the app exists and isn't already registered
add_login_item(){
  local app_path="$1"
  local app_name
  app_name=$(basename "$app_path" .app)

  if [[ ! -d "$app_path" ]]; then
    log "Skipping login item (not installed): $app_name"
    return 0
  fi

  # Check/add login items via System Events (requires Automation permission)
  local osascript_err
  osascript_err=$(osascript -e "tell application \"System Events\" to get the name of every login item" 2>&1) && {
    if echo "$osascript_err" | grep -q "$app_name"; then
      log "Login item already exists: $app_name"
      return 0
    fi
  } || {
    if echo "$osascript_err" | grep -q "Not authorized"; then
      log "Cannot manage login items (Automation permission not granted)"
      log "  → Add $app_name manually: System Settings → General → Login Items"
      return 0
    fi
    return 1
  }

  osascript -e "tell application \"System Events\" to make login item at end with properties {path:\"$app_path\", hidden:false}" >/dev/null 2>&1 || {
    log "Failed to add login item: $app_name"
    log "  → Add manually: System Settings → General → Login Items"
    return 1
  }
  log "Added login item: $app_name"
}

# Add login items for apps on this machine
add_login_item "/Applications/noTunes.app"          || incr_failed
add_login_item "/Applications/SoundSource.app"      || incr_failed
add_login_item "/Applications/Loopback.app"         || incr_failed

###############################################################################
# Summary                                                                     #
###############################################################################

if (( failed > 0 )); then
  log "Warning: $failed post-install step(s) failed"
else
  log "Post-install complete"
fi
